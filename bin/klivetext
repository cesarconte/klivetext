"""
klivetext: Universal Screen OCR & Data Detector para KDE Plasma 6 (Wayland)
"""

import sys
import os
import json
import subprocess
import argparse
import atexit
import threading
import tempfile
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_DIR = SCRIPT_DIR.parent
if (PROJECT_DIR / "src").exists():
    LIB_DIR = PROJECT_DIR
else:
    LIB_DIR = Path.home() / ".local/share/klivetext"

sys.path.insert(0, str(LIB_DIR / "src"))

from ocrengine import run_ocr

DATA_PAYLOAD_PATH = Path("/dev/shm/klivetext_data.json")
DEFAULT_CAPTURE_PATH = Path("/dev/shm/klivetext_capture.png")
QML_FILE_PATH = LIB_DIR / "src/ui/LiveTextOverlay.qml"

# ---------------------------------------------------------------------------
# Local action channel
#
# The QML overlay runs under the generic `qml` runtime, which cannot spawn
# processes on its own, so the overlay asks this tiny loopback server to run
# one of a strictly whitelisted set of commands. It binds to 127.0.0.1 only and
# never invokes a shell.
# ---------------------------------------------------------------------------
ACTION_HOST = "127.0.0.1"
ACTION_PORT = 1742

ALLOWED_COMMANDS = {
    "wl-copy": (),
    "kdeconnect-cli": ("--share-text",),
}

# Commands that need a KDE Connect device and accept one through -d / -n.
DEVICE_COMMANDS = {"kdeconnect-cli"}


def resolve_default_device() -> str | None:
    """Returns the identifier of the first reachable KDE Connect device."""
    try:
        result = subprocess.run(
            ["kdeconnect-cli", "--list-available", "--id-only"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None

    for line in result.stdout.splitlines():
        candidate = line.strip()
        if candidate:
            return candidate
    return None


class ActionHandler(BaseHTTPRequestHandler):
    """Handles the `POST /action` requests of the QML overlay."""

    def log_message(self, fmt, *args):  # noqa: D401 - silence the default logging
        """Keeps the console clean: the actions are reported by the UI itself."""

    def _reply(self, status: int, payload: dict) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):  # noqa: N802 - required by BaseHTTPRequestHandler
        if self.path != "/action":
            self._reply(404, {"ok": False, "error": "unknown endpoint"})
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            request = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError, json.JSONDecodeError):
            self._reply(400, {"ok": False, "error": "invalid request"})
            return

        command = request.get("cmd", "")
        args = request.get("args", [])

        if command not in ALLOWED_COMMANDS:
            self._reply(403, {"ok": False, "error": f"command not allowed: {command}"})
            return

        if not isinstance(args, list) or not all(isinstance(arg, str) for arg in args):
            self._reply(400, {"ok": False, "error": "invalid arguments"})
            return

        try:
            # The payload is always passed as an argument. The output is
            # collected in a temporary file instead of a pipe: `wl-copy` keeps
            # running in the background to hold the clipboard selection and it
            # would inherit an open pipe, blocking the request forever.
            with tempfile.TemporaryFile(mode="w+") as errors:
                invocation = [command, *args]

                # KDE Connect needs an explicit device when the caller does not
                # provide one: the first reachable device is used.
                if command in DEVICE_COMMANDS and not any(a in ("-d", "-n", "--device", "--name") for a in args):
                    device = resolve_default_device()
                    if device is None:
                        self._reply(503, {"ok": False, "error": "No hay ningún dispositivo KDE Connect disponible"})
                        return
                    invocation = [command, "-d", device, *args]

                process = subprocess.Popen(
                    invocation,
                    stdout=subprocess.DEVNULL,
                    stderr=errors,
                    text=True,
                    start_new_session=True,
                )
                try:
                    returncode = process.wait(timeout=2.0)
                except subprocess.TimeoutExpired:
                    # The command is still alive on purpose: it holds the
                    # clipboard selection in the background.
                    returncode = 0
                    process.kill()

                errors.seek(0)
                message = errors.read().strip()
        except (OSError, subprocess.SubprocessError) as exc:
            self._reply(500, {"ok": False, "error": str(exc)})
            return

        if returncode != 0:
            self._reply(500, {"ok": False, "error": message or "command failed"})
            return

        self._reply(200, {"ok": True})


class ActionServer:
    """Loopback HTTP server that exposes the whitelisted actions to the QML."""

    def __init__(self, host: str = ACTION_HOST, port: int = ACTION_PORT) -> None:
        self._host = host
        self._port = port
        self._httpd: HTTPServer | None = None
        self._thread: threading.Thread | None = None

    def start(self) -> bool:
        try:
            self._httpd = HTTPServer((self._host, self._port), ActionHandler)
        except OSError:
            return False
        self._thread = threading.Thread(target=self._httpd.serve_forever, daemon=True)
        self._thread.start()
        return True

    def stop(self) -> None:
        if self._httpd is not None:
            self._httpd.shutdown()
            self._httpd.server_close()
            self._httpd = None


def cleanup():
    """Limpia archivos temporales en memoria compartida al salir."""
    if DEFAULT_CAPTURE_PATH.exists():
        try:
            DEFAULT_CAPTURE_PATH.unlink()
        except OSError:
            pass
    if DATA_PAYLOAD_PATH.exists():
        try:
            DATA_PAYLOAD_PATH.unlink()
        except OSError:
            pass


atexit.register(cleanup)


def capture_screen_area(output_path: Path) -> bool:
    """Invoca Spectacle en Wayland para capturar una región en RAM."""
    if output_path.exists():
        output_path.unlink()

    cmd = ["spectacle", "-r", "-b", "-n", "-k", "-o", str(output_path)]
    try:
        res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return res.returncode == 0 and output_path.exists() and output_path.stat().st_size > 0
    except Exception as exc:
        print(f"Error al ejecutar Spectacle: {exc}", file=sys.stderr)
        return False


def copy_to_clipboard(text: str):
    """Copia texto al portapapeles de Wayland."""
    if not text:
        return
    try:
        subprocess.run(["wl-copy"], input=text, text=True, check=True)
    except Exception:
        pass


def main():
    parser = argparse.ArgumentParser(
        description="KLiveText: Universal Screen OCR & Data Detector para KDE Plasma 6"
    )
    parser.add_argument("image", nargs="?", type=Path, default=None, help="Imagen a analizar (si se omite, captura región de pantalla)")
    parser.add_argument("-c", "--copy-only", action="store_true", help="Modo sin interfaz: solo copia el texto y sale")
    parser.add_argument("-v", "--version", action="version", version="KLiveText 1.0.0")

    args = parser.parse_args()

    image_path = args.image
    if not image_path:
        print("📸 Selecciona la región de pantalla para KLiveText...")
        if not capture_screen_area(DEFAULT_CAPTURE_PATH):
            print("Captura cancelada.")
            sys.exit(0)
        image_path = DEFAULT_CAPTURE_PATH

    print(f"🔍 Procesando OCR y Data Detectors: {image_path.name}...")
    try:
        data = run_ocr(image_path)
    except Exception as exc:
        print(f"❌ Error durante el OCR: {exc}", file=sys.stderr)
        sys.exit(1)

    # Copiar texto inmediatamente al portapapeles
    if data["full_text"]:
        copy_to_clipboard(data["full_text"])

    if args.copy_only:
        print(data["full_text"])
        sys.exit(0)

    # Guardar estado en memoria compartida para la UI
    with open(DATA_PAYLOAD_PATH, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

    # Lanzar la interfaz interactiva QML (diseño CachyOS.UI)
    env = os.environ.copy()
    env["QML_XHR_ALLOW_FILE_READ"] = "1"

    # El módulo de diseño CachyOS.UI vive en el prefijo del usuario.
    qml_import_paths = [
        path
        for path in (
            os.environ.get("QML2_IMPORT_PATH", ""),
            str(Path.home() / ".local/lib/qt6/qml"),
            "/usr/lib/qt6/qml",
        )
        if path
    ]
    env["QML2_IMPORT_PATH"] = ":".join(dict.fromkeys(qml_import_paths))

    # Estilo de controles de Plasma, como el resto del ecosistema CachyOS.UI.
    if not env.get("QT_QUICK_CONTROLS_STYLE"):
        env["QT_QUICK_CONTROLS_STYLE"] = "org.kde.desktop"

    # Canal de acciones para la interfaz (copiar, enviar al móvil).
    server = ActionServer()
    if not server.start():
        print("⚠️  No se pudo iniciar el canal de acciones local.", file=sys.stderr)
    else:
        atexit.register(server.stop)

    qml_bin = shutil_which_qml()

    cmd = [qml_bin, str(QML_FILE_PATH)]
    try:
        subprocess.run(cmd, env=env, check=True)
    except Exception as exc:
        print(f"Error al abrir la interfaz: {exc}", file=sys.stderr)
        sys.exit(1)
    finally:
        server.stop()


def shutil_which_qml() -> str:
    for candidate in ["/usr/lib/qt6/bin/qml", "qml6", "qml"]:
        path = subprocess.run(["which", candidate], capture_output=True, text=True).stdout.strip()
        if path and os.path.exists(path):
            return path
    return "/usr/lib/qt6/bin/qml"


if __name__ == "__main__":
    main()
